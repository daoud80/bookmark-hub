{
  "manifest_version": 3,
  "name": "Bookmark Hub",
  "version": "1.0.1",
  "description": "Turn your bookmarks into a searchable start page with icons and your own notes. Updates live. No servers, no tracking.",
  "minimum_chrome_version": "111",
  "permissions": ["bookmarks", "favicon", "storage"],
  "action": {
    "default_title": "Open Bookmark Hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "hub.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
